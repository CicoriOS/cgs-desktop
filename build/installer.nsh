LangString CGS_MAINT_SUBTITLE 1033 "Choose what to do"
LangString CGS_MAINT_SUBTITLE 2052 "选择要执行的操作"
LangString CGS_MAINT_UNKNOWN 1033 "CGS Desktop is already installed on this computer."
LangString CGS_MAINT_UNKNOWN 2052 "这台电脑上已经安装了 CGS Desktop。"
LangString CGS_MAINT_SAME 1033 "Version $cgsInstalledVersion is installed, the same version as this installer."
LangString CGS_MAINT_SAME 2052 "已安装的版本是 $cgsInstalledVersion，与本安装程序的版本相同。"
LangString CGS_MAINT_NEWER 1033 "Version $cgsInstalledVersion is installed. This installer carries the newer version ${VERSION}."
LangString CGS_MAINT_NEWER 2052 "已安装的版本是 $cgsInstalledVersion，本安装程序带的是更新的版本 ${VERSION}。"
LangString CGS_MAINT_OLDER 1033 "Version $cgsInstalledVersion is installed, which is newer than this installer (${VERSION})."
LangString CGS_MAINT_OLDER 2052 "已安装的版本是 $cgsInstalledVersion，比本安装程序（${VERSION}）更新。"
LangString CGS_MAINT_UPGRADE 1033 "Upgrade to ${VERSION}  (keeps your settings, sign-in and tools)"
LangString CGS_MAINT_UPGRADE 2052 "升级到 ${VERSION}（保留设置、登录和工具）"
LangString CGS_MAINT_REINSTALL 1033 "Reinstall  (replaces the app files; keeps your settings, sign-in and tools)"
LangString CGS_MAINT_REINSTALL 2052 "重新安装（覆盖程序文件；保留设置、登录和工具）"
LangString CGS_MAINT_REINSTALL_OLDER 1033 "Reinstall with the older version ${VERSION}  (replaces the newer app files; keeps your data)"
LangString CGS_MAINT_REINSTALL_OLDER 2052 "用较旧的版本 ${VERSION} 重新安装（覆盖较新的程序文件；保留你的数据）"
LangString CGS_MAINT_UNINSTALL 1033 "Uninstall  (you choose what to remove on the next screen)"
LangString CGS_MAINT_UNINSTALL 2052 "卸载（下一步选择要卸载的内容）"

LangString CGS_UN_TITLE 1033 "What to remove"
LangString CGS_UN_TITLE 2052 "选择要卸载的内容"
LangString CGS_UN_SUBTITLE 1033 "CGS Desktop itself is always removed"
LangString CGS_UN_SUBTITLE 2052 "CGS Desktop 本体一定会被卸载"
LangString CGS_UN_INTRO 1033 "Your CGS sign-in is always removed together with CGS Desktop; it is never kept.$\r$\n$\r$\nUntick what you want to keep."
LangString CGS_UN_INTRO 2052 "CGS 登录凭据一定会随 CGS Desktop 一起删除，不会保留。$\r$\n$\r$\n取消勾选你想保留的内容。"
LangString CGS_UN_TOOLS 1033 "The tools CGS Desktop downloaded (Git, Python, clang, Rust, language servers) and their entries on your user PATH"
LangString CGS_UN_TOOLS 2052 "CGS Desktop 下载的工具（Git、Python、clang、Rust、语言服务器）及其用户 PATH 项"
LangString CGS_UN_CLI 1033 "The cgs command line tool (it also disappears from your own terminals)"
LangString CGS_UN_CLI 2052 "cgs 命令行工具（你自己终端里的 cgs 也会一起消失）"
LangString CGS_UN_DATA 1033 "Settings, sessions and history, including the API keys of other providers that the CLI saved (cannot be undone)"
LangString CGS_UN_DATA 2052 "设置、会话与历史记录，包括命令行工具保存的其他供应商的 API 密钥（无法恢复）"

; $LOCALAPPDATA is resolved at install time. The helpers live beside the toolchain root (not in it) so uninstall can still
; run them while the toolchain is being removed.
!macro CGS_InitHelperPaths
  StrCpy $cgsPathHelperDir "$LOCALAPPDATA\cgs-desktop"
  StrCpy $cgsPathHelper "$cgsPathHelperDir\cgs-path.ps1"
  StrCpy $cgsUninstallHelper "$cgsPathHelperDir\cgs-uninstall.ps1"
!macroend

!ifndef BUILD_UNINSTALLER
; Compare "<x.y.z>[-pre]" strings. Core parts compare naturally (digit runs as numbers, shlwapi's StrCmpLogicalW); with equal
; cores a release is newer than a prerelease, and two prereleases compare naturally. Input $R0; output core $R1, pre $R2.
Function CGS_SplitVersion
  StrCpy $R1 $R0
  StrCpy $R2 ""
  StrCpy $R9 0
  CGS_SplitLoop:
    StrCpy $R8 $R0 1 $R9
    StrCmp $R8 "" CGS_SplitDone
    StrCmp $R8 "-" CGS_SplitFound
    StrCmp $R8 "+" CGS_SplitFound
    IntOp $R9 $R9 + 1
    Goto CGS_SplitLoop
  CGS_SplitFound:
    StrCpy $R1 $R0 $R9
    IntOp $R9 $R9 + 1
    StrCpy $R2 $R0 "" $R9
  CGS_SplitDone:
FunctionEnd

; Sets $cgsRelation to how this installer's version relates to the installed one: same, newer, older, or unknown.
Function CGS_CompareVersions
  StrCpy $cgsRelation "unknown"
  StrCmp $cgsInstalledVersion "" CGS_CompareEnd
  StrCpy $R0 $cgsInstalledVersion
  Call CGS_SplitVersion
  StrCpy $R3 $R1
  StrCpy $R4 $R2
  StrCpy $R0 "${VERSION}"
  Call CGS_SplitVersion
  ; $R3/$R4: installed core/pre. $R1/$R2: this installer's. StrCmpLogicalW(installed, ours) < 0 means ours is newer.
  System::Call 'shlwapi::StrCmpLogicalW(w R3, w R1) i .r0'
  ${If} $0 < 0
    StrCpy $cgsRelation "newer"
    Goto CGS_CompareEnd
  ${ElseIf} $0 > 0
    StrCpy $cgsRelation "older"
    Goto CGS_CompareEnd
  ${EndIf}
  ${If} $R4 == ""
  ${AndIf} $R2 == ""
    StrCpy $cgsRelation "same"
  ${ElseIf} $R4 == ""
    ; installed is a release, ours is a prerelease of the same core: older
    StrCpy $cgsRelation "older"
  ${ElseIf} $R2 == ""
    StrCpy $cgsRelation "newer"
  ${Else}
    System::Call 'shlwapi::StrCmpLogicalW(w R4, w R2) i .r0'
    ${If} $0 < 0
      StrCpy $cgsRelation "newer"
    ${ElseIf} $0 > 0
      StrCpy $cgsRelation "older"
    ${Else}
      StrCpy $cgsRelation "same"
    ${EndIf}
  ${EndIf}
  CGS_CompareEnd:
FunctionEnd
!endif

; Default: add. Set before any page runs so a silent install (no page) keeps it.
!macro customInit
  !insertmacro CGS_InitHelperPaths
  StrCpy $cgsAddToPath "1"
  StrCpy $cgsMode ""
  ; ${isUpdated} uses the StdUtils plugin, whose search path is added by electron-builder after this header is
  ; included, so it may only be expanded in a hook that installer.nsi inserts later, never in a function defined here.
  ${If} ${isUpdated}
    StrCpy $cgsIsUpdate "1"
  ${Else}
    StrCpy $cgsIsUpdate "0"
  ${EndIf}
  ; An installed copy: its registry entries must be there and its executable must exist. Anything less is a leftover that
  ; the normal install cleans up, not something to ask about.
  StrCpy $cgsRelation ""
  StrCpy $cgsInstalledVersion ""
  StrCpy $cgsUninstallString ""
  ReadRegStr $1 HKCU "${INSTALL_REGISTRY_KEY}" InstallLocation
  ReadRegStr $cgsUninstallString HKCU "${UNINSTALL_REGISTRY_KEY}" UninstallString
  ReadRegStr $cgsInstalledVersion HKCU "${UNINSTALL_REGISTRY_KEY}" DisplayVersion
  ${If} $cgsUninstallString == ""
    ReadRegStr $1 HKLM "${INSTALL_REGISTRY_KEY}" InstallLocation
    ReadRegStr $cgsUninstallString HKLM "${UNINSTALL_REGISTRY_KEY}" UninstallString
    ReadRegStr $cgsInstalledVersion HKLM "${UNINSTALL_REGISTRY_KEY}" DisplayVersion
  ${EndIf}
  ${If} $cgsUninstallString != ""
  ${AndIf} $1 != ""
  ${AndIf} ${FileExists} "$1\${APP_EXECUTABLE_FILENAME}"
    Call CGS_CompareVersions
  ${EndIf}
  ; The installer carries English and Simplified Chinese. Pick by the Windows UI language instead of showing a language
  ; dialog; MUI then renders its own pages in the same language. Everything else uses English.
  System::Call 'kernel32::GetUserDefaultUILanguage() i .r0'
  ${If} $0 == 2052
  ${OrIf} $0 == 4100
  ${OrIf} $0 == 3076
  ${OrIf} $0 == 1028
    StrCpy $LANGUAGE 2052
  ${Else}
    StrCpy $LANGUAGE 1033
  ${EndIf}
!macroend

; The first page: only when an installed copy was found and this is not an update (electron-updater runs the installer
; with --updated; that path must stay silent and keep everything).
!macro customWelcomePage
  Page custom CGS_MaintPageCreate CGS_MaintPageLeave
!macroend

; One checkbox, after the directory page, exactly where electron-builder's assisted installer has a hook for it.
!macro customPageAfterChangeDir
  Page custom CGS_PathPageCreate CGS_PathPageLeave
!macroend

!ifndef BUILD_UNINSTALLER
Function CGS_MaintPageCreate
  ${If} $cgsRelation == ""
  ${OrIf} $cgsIsUpdate == "1"
    Abort
  ${EndIf}
  !insertmacro MUI_HEADER_TEXT "$(CGS_MAINT_TITLE)" "$(CGS_MAINT_SUBTITLE)"
  nsDialogs::Create 1018
  Pop $0
  ${If} $0 == error
    Abort
  ${EndIf}
  ${If} $cgsRelation == "same"
    ${NSD_CreateLabel} 0 0 100% 24u "$(CGS_MAINT_SAME)"
  ${ElseIf} $cgsRelation == "newer"
    ${NSD_CreateLabel} 0 0 100% 24u "$(CGS_MAINT_NEWER)"
  ${ElseIf} $cgsRelation == "older"
    ${NSD_CreateLabel} 0 0 100% 24u "$(CGS_MAINT_OLDER)"
  ${Else}
    ${NSD_CreateLabel} 0 0 100% 24u "$(CGS_MAINT_UNKNOWN)"
  ${EndIf}
  Pop $1
  StrCpy $cgsAction1 ""
  StrCpy $cgsAction2 ""
  StrCpy $cgsAction3 ""
  ; The safe choice is first and preselected: upgrade when there is one, else reinstall; uninstall is always last.
  ${If} $cgsRelation == "newer"
    ${NSD_CreateFirstRadioButton} 0 30u 100% 12u "$(CGS_MAINT_UPGRADE)"
    Pop $cgsRadio1
    StrCpy $cgsAction1 "upgrade"
    ${NSD_CreateRadioButton} 0 46u 100% 12u "$(CGS_MAINT_REINSTALL)"
    Pop $cgsRadio2
    StrCpy $cgsAction2 "reinstall"
    ${NSD_CreateRadioButton} 0 62u 100% 12u "$(CGS_MAINT_UNINSTALL)"
    Pop $cgsRadio3
    StrCpy $cgsAction3 "uninstall"
  ${ElseIf} $cgsRelation == "older"
    ${NSD_CreateFirstRadioButton} 0 30u 100% 12u "$(CGS_MAINT_REINSTALL_OLDER)"
    Pop $cgsRadio1
    StrCpy $cgsAction1 "reinstall"
    ${NSD_CreateRadioButton} 0 46u 100% 12u "$(CGS_MAINT_UNINSTALL)"
    Pop $cgsRadio2
    StrCpy $cgsAction2 "uninstall"
  ${Else}
    ${NSD_CreateFirstRadioButton} 0 30u 100% 12u "$(CGS_MAINT_REINSTALL)"
    Pop $cgsRadio1
    StrCpy $cgsAction1 "reinstall"
    ${NSD_CreateRadioButton} 0 46u 100% 12u "$(CGS_MAINT_UNINSTALL)"
    Pop $cgsRadio2
    StrCpy $cgsAction2 "uninstall"
  ${EndIf}
  ${NSD_Check} $cgsRadio1
  nsDialogs::Show
FunctionEnd

Function CGS_MaintPageLeave
  StrCpy $0 $cgsAction1
  ${NSD_GetState} $cgsRadio1 $1
  ${If} $1 != 1
    StrCpy $0 $cgsAction2
    ${NSD_GetState} $cgsRadio2 $1
    ${If} $1 != 1
      StrCpy $0 $cgsAction3
    ${EndIf}
  ${EndIf}
  ${If} $0 == "uninstall"
    ; Hand over to the installed uninstaller (it asks what to remove) and end this installer. The uninstaller copies itself
    ; to a temporary folder first, so it does not matter that this process exits at once.
    Exec '$cgsUninstallString'
    Quit
  ${EndIf}
  StrCpy $cgsMode $0
FunctionEnd

Function CGS_PathPageCreate
  ; An update and an upgrade keep the choice made on the first install.
  ${If} $cgsIsUpdate == "1"
  ${OrIf} $cgsMode == "upgrade"
    Abort
  ${EndIf}
  !insertmacro MUI_HEADER_TEXT "$(CGS_PATH_TITLE)" "$(CGS_PATH_SUBTITLE)"
  nsDialogs::Create 1018
  Pop $0
  ${If} $0 == error
    Abort
  ${EndIf}
  ${NSD_CreateLabel} 0 0 100% 34u "$(CGS_PATH_INTRO)"
  Pop $1
  ${NSD_CreateCheckbox} 0 44u 100% 12u "$(CGS_PATH_CHECK)"
  Pop $cgsPathCheckbox
  ${NSD_Check} $cgsPathCheckbox
  ${NSD_CreateLabel} 0 64u 100% 30u "$(CGS_PATH_HINT)"
  Pop $1
  nsDialogs::Show
FunctionEnd

Function CGS_PathPageLeave
  ${NSD_GetState} $cgsPathCheckbox $0
  ${If} $0 == 1
    StrCpy $cgsAddToPath "1"
  ${Else}
    StrCpy $cgsAddToPath "0"
  ${EndIf}
FunctionEnd
!endif

; Run the PATH helper in one of its modes. Failure is logged and never aborts the install or uninstall: a PATH that was not
; changed is the safe side, and the message names the mode that failed.
!macro CGS_RunPathHelper MODE
  ${If} ${FileExists} "$cgsPathHelper"
    DetailPrint "CGS: ${MODE} user PATH"
    nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$cgsPathHelper" -Mode ${MODE} -Root "${CGS_TOOLCHAIN_ROOT}" -Entries "${CGS_USER_PATH_ENTRIES}" -RecordKey "Software\${APP_ID}"'
    Pop $0
    Pop $1
    DetailPrint "CGS: PATH ${MODE} exit code $0"
    ${If} $1 != ""
      DetailPrint "CGS: $1"
    ${EndIf}
    ${If} $0 != "0"
      DetailPrint "CGS: PATH ${MODE} failed; the user PATH was left unchanged"
    ${EndIf}
  ${Else}
    DetailPrint "CGS: PATH ${MODE} skipped: $cgsPathHelper is missing"
  ${EndIf}
!macroend

!macro customInstall
  ; The helpers live outside the toolchain root so uninstall can still run them while removing that root.
  CreateDirectory "$cgsPathHelperDir"
  SetOutPath "$cgsPathHelperDir"
  File "/oname=cgs-path.ps1" "${BUILD_RESOURCES_DIR}\win-path.ps1"
  File "/oname=cgs-uninstall.ps1" "${BUILD_RESOURCES_DIR}\win-uninstall.ps1"
  SetOutPath "$INSTDIR"
  ${If} ${isUpdated}
  ${OrIf} $cgsMode == "upgrade"
    ; An update keeps whatever the user chose: only re-record the entries that are still there.
    !insertmacro CGS_RunPathHelper "refresh"
  ${ElseIf} $cgsAddToPath == "1"
    !insertmacro CGS_RunPathHelper "add"
  ${ElseIf} $cgsMode == "reinstall"
    ; The user ticked the box on the first install and unticked it now: take the recorded entries off again.
    !insertmacro CGS_RunPathHelper "remove"
  ${Else}
    DetailPrint "CGS: user chose not to add the tools to the user PATH"
  ${EndIf}
!macroend

!ifdef BUILD_UNINSTALLER
; The three optional components default to removed, which is also what a silent uninstall does. Flags keep a component:
; --keep-tools, --keep-cli, --keep-data. (The page below overrides them when it is shown.)
!macro customUnInit
  StrCpy $cgsRmTools "1"
  StrCpy $cgsRmCli "1"
  StrCpy $cgsRmData "1"
  ${GetParameters} $R0
  ClearErrors
  ${GetOptions} $R0 "--keep-tools" $R1
  ${IfNot} ${Errors}
    StrCpy $cgsRmTools "0"
  ${EndIf}
  ClearErrors
  ${GetOptions} $R0 "--keep-cli" $R1
  ${IfNot} ${Errors}
    StrCpy $cgsRmCli "0"
  ${EndIf}
  ClearErrors
  ${GetOptions} $R0 "--keep-data" $R1
  ${IfNot} ${Errors}
    StrCpy $cgsRmData "0"
  ${EndIf}
  ClearErrors
!macroend

!macro customUnWelcomePage
  !insertmacro MUI_UNPAGE_WELCOME
  UninstPage custom un.CGS_ComponentsCreate un.CGS_ComponentsLeave
!macroend

Function un.CGS_ComponentsCreate
  ; Not shown for an update's silent uninstall or for /S: NSIS skips every page in silent mode.
  !insertmacro MUI_HEADER_TEXT "$(CGS_UN_TITLE)" "$(CGS_UN_SUBTITLE)"
  nsDialogs::Create 1018
  Pop $0
  ${If} $0 == error
    Abort
  ${EndIf}
  ${NSD_CreateLabel} 0 0 100% 34u "$(CGS_UN_INTRO)"
  Pop $1
  ${NSD_CreateCheckbox} 0 44u 100% 22u "$(CGS_UN_TOOLS)"
  Pop $cgsToolsBox
  ${NSD_CreateCheckbox} 0 70u 100% 12u "$(CGS_UN_CLI)"
  Pop $cgsCliBox
  ${NSD_CreateCheckbox} 0 86u 100% 22u "$(CGS_UN_DATA)"
  Pop $cgsDataBox
  ${If} $cgsRmTools == "1"
    ${NSD_Check} $cgsToolsBox
  ${EndIf}
  ${If} $cgsRmCli == "1"
    ${NSD_Check} $cgsCliBox
  ${EndIf}
  ${If} $cgsRmData == "1"
    ${NSD_Check} $cgsDataBox
  ${EndIf}
  nsDialogs::Show
FunctionEnd

Function un.CGS_ComponentsLeave
  ${NSD_GetState} $cgsToolsBox $0
  ${If} $0 == 1
    StrCpy $cgsRmTools "1"
  ${Else}
    StrCpy $cgsRmTools "0"
  ${EndIf}
  ${NSD_GetState} $cgsCliBox $0
  ${If} $0 == 1
    StrCpy $cgsRmCli "1"
  ${Else}
    StrCpy $cgsRmCli "0"
  ${EndIf}
  ${NSD_GetState} $cgsDataBox $0
  ${If} $0 == 1
    StrCpy $cgsRmData "1"
  ${Else}
    StrCpy $cgsRmData "0"
  ${EndIf}
FunctionEnd
!endif

; Everything the uninstaller removes besides the app files is done by the uninstall helper: it stops the processes that hold
; files, removes the credentials always, and the chosen components. A missing helper is reported, never improvised around.
!macro CGS_RunUninstallHelper
  ${If} ${FileExists} "$cgsUninstallHelper"
    DetailPrint "CGS: removing credentials and the chosen components"
    nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$cgsUninstallHelper" -InstallDir "$INSTDIR" -ToolchainRoot "${CGS_TOOLCHAIN_ROOT}" -BundledBun "$INSTDIR\resources\tools\bun.exe" -RemoveTools $cgsRmTools -RemoveCli $cgsRmCli -RemoveData $cgsRmData -AppDataNames "${CGS_APPDATA_NAMES}" -UpdaterCache "${APP_PACKAGE_NAME}-updater"'
    Pop $0
    Pop $1
    DetailPrint "CGS: uninstall helper exit code $0"
    ${If} $1 != ""
      DetailPrint "CGS: $1"
    ${EndIf}
    ${If} $0 != "0"
      DetailPrint "CGS: some items could not be removed; see %TEMP%\cgs-desktop-uninstall.log"
    ${EndIf}
  ${Else}
    DetailPrint "CGS: $cgsUninstallHelper is missing; the credentials and the optional components were NOT removed"
  ${EndIf}
!macroend

!macro customUnInstall
  !insertmacro CGS_InitHelperPaths
  ${If} ${isUpdated}
    DetailPrint "CGS: update; keeping the user PATH, the toolchain and all user data"
  ${Else}
    ; The PATH entries go with the tools they point at; kept tools keep their entries (and the record is dropped with the
    ; uninstall registry key below, which only means a later install adds them again, idempotently).
    ${If} $cgsRmTools == "1"
      !insertmacro CGS_RunPathHelper "remove"
    ${EndIf}
    !insertmacro CGS_RunUninstallHelper
    Delete "$cgsPathHelper"
    Delete "$cgsUninstallHelper"
    Delete "$cgsPathHelperDir\cgs-path.log"
    ; Only an empty folder goes: kept tools live in a subfolder of it.
    RMDir "$cgsPathHelperDir"
    DeleteRegKey /ifempty HKCU "Software\${APP_ID}"
  ${EndIf}
!macroend

!endif

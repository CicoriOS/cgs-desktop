; Windows installer customisation (ADR 0049 §1–§2, decided in [O13]): the installer ships only the shell, the UI, bun.exe
; and aria2c.exe; the rest of the toolchain is downloaded on first run. This file asks — once, in the wizard — whether those
; future tool directories should be put on the *user* PATH (HKCU, no administrator rights), defaulting to yes, and records the
; answer so uninstall can remove exactly those entries again.
;
; Security and correctness notes:
;   - The registry work is done by build/win-path.ps1 (run through nsExec), not by NSIS's registry plugin. NSIS strings are
;     too short for a large PATH, and a partial write would truncate the user's PATH; the script reads and writes the whole
;     value, keeps REG_EXPAND_SZ, and refuses (without writing) above 30 000 characters.
;   - The page is skipped on an update (${isUpdated}); an update must not re-ask or re-add. Silent fresh installs keep the
;     default (checked), as no page is shown.
;   - Uninstall removes only the recorded entries and the toolchain root; %USERPROFILE%\.cgs and .bun are never touched.
;
; Included before installer.nsi's own MUI2 include by electron-builder's NSIS header, so pull MUI2 in here first.
!include "MUI2.nsh"

!ifndef CGS_INSTALLER_NSH
!define CGS_INSTALLER_NSH

; Generated by scripts/fetch-win-bundle.mjs from desktop/toolchain/layout.json.
!include "${BUILD_RESOURCES_DIR}/win-bundle/userpaths.nsh"

!ifndef BUILD_UNINSTALLER
Var cgsAddToPath
Var cgsPathCheckbox
Var cgsIsUpdate
!endif
Var cgsPathHelperDir
Var cgsPathHelper

LangString CGS_PATH_TITLE 1033 "CGS tools"
LangString CGS_PATH_TITLE 2052 "CGS 工具"
LangString CGS_PATH_SUBTITLE 1033 "Choose whether the tools go on your user PATH"
LangString CGS_PATH_SUBTITLE 2052 "选择是否把工具加入你的用户 PATH"
LangString CGS_PATH_INTRO 1033 "CGS Desktop downloads Git, Python, clang, Rust and the language servers on first run.$\r$\n$\r$\nAdding their directories to your user PATH lets you use them in your own terminals. This changes only your account and needs no administrator rights."
LangString CGS_PATH_INTRO 2052 "CGS Desktop 会在首次运行时下载 Git、Python、clang、Rust 与语言服务器。$\r$\n$\r$\n把它们的目录加入你的用户 PATH 后，你可以在自己的终端里直接使用这些工具。这只修改你的账户，不需要管理员权限。"
LangString CGS_PATH_CHECK 1033 "Add the CGS tools to my user PATH (no administrator rights needed)"
LangString CGS_PATH_CHECK 2052 "将 CGS 工具加入我的用户 PATH（不需要管理员权限）"
LangString CGS_PATH_HINT 1033 "If you leave this unticked, the desktop app and the agents it starts still find the tools; only your own terminals will not."
LangString CGS_PATH_HINT 2052 "取消勾选时，桌面应用及其启动的 agent 仍然能找到这些工具，只是你自己的终端找不到。"

; $LOCALAPPDATA is resolved at install time. The helper lives beside the toolchain root (not in it) so uninstall can still run
; it while the toolchain is being removed.
!macro CGS_InitHelperPaths
  StrCpy $cgsPathHelperDir "$LOCALAPPDATA\cgs-desktop"
  StrCpy $cgsPathHelper "$cgsPathHelperDir\cgs-path.ps1"
!macroend

; Default: add. Set before any page runs so a silent install (no page) keeps it.
!macro customInit
  !insertmacro CGS_InitHelperPaths
  StrCpy $cgsAddToPath "1"
  ; ${isUpdated} uses the StdUtils plugin, whose search path is added by electron-builder after this header is
  ; included, so it may only be expanded in a hook that installer.nsi inserts later, never in a function defined here.
  ${If} ${isUpdated}
    StrCpy $cgsIsUpdate "1"
  ${Else}
    StrCpy $cgsIsUpdate "0"
  ${EndIf}
  ; The installer carries English and Simplified Chinese. Pick by the Windows UI language instead of showing a language
  ; dialog; MUI then renders its own pages in the same language. Everything else uses English.
  System::Call 'kernel32::GetUserDefaultUILanguage() i .r0'
  ${If} $0 == 2052
  ${OrIf} $0 == 4100
  ${OrIf} $0 == 3076
  ${OrIf} $0 == 1028
    StrCpy $LANGUAGE 2052
  ${Else}
    StrCpy $LANGUAGE 1033
  ${EndIf}
!macroend

; One checkbox, after the directory page, exactly where electron-builder's assisted installer has a hook for it.
!macro customPageAfterChangeDir
  Page custom CGS_PathPageCreate CGS_PathPageLeave
!macroend

!ifndef BUILD_UNINSTALLER
Function CGS_PathPageCreate
  ${If} $cgsIsUpdate == "1"
    Abort
  ${EndIf}
  !insertmacro MUI_HEADER_TEXT "$(CGS_PATH_TITLE)" "$(CGS_PATH_SUBTITLE)"
  nsDialogs::Create 1018
  Pop $0
  ${If} $0 == error
    Abort
  ${EndIf}
  ${NSD_CreateLabel} 0 0 100% 34u "$(CGS_PATH_INTRO)"
  Pop $1
  ${NSD_CreateCheckbox} 0 44u 100% 12u "$(CGS_PATH_CHECK)"
  Pop $cgsPathCheckbox
  ${NSD_Check} $cgsPathCheckbox
  ${NSD_CreateLabel} 0 64u 100% 30u "$(CGS_PATH_HINT)"
  Pop $1
  nsDialogs::Show
FunctionEnd

Function CGS_PathPageLeave
  ${NSD_GetState} $cgsPathCheckbox $0
  ${If} $0 == 1
    StrCpy $cgsAddToPath "1"
  ${Else}
    StrCpy $cgsAddToPath "0"
  ${EndIf}
FunctionEnd
!endif

; Run the helper in one of its modes. Failure is logged and never aborts the install or uninstall: a PATH that was not
; changed is the safe side, and the message names the mode that failed.
!macro CGS_RunPathHelper MODE
  ${If} ${FileExists} "$cgsPathHelper"
    DetailPrint "CGS: ${MODE} user PATH"
    nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$cgsPathHelper" -Mode ${MODE} -Root "${CGS_TOOLCHAIN_ROOT}" -Entries "${CGS_USER_PATH_ENTRIES}" -RecordKey "Software\${APP_ID}"'
    Pop $0
    Pop $1
    DetailPrint "CGS: PATH ${MODE} exit code $0"
    ${If} $1 != ""
      DetailPrint "CGS: $1"
    ${EndIf}
    ${If} $0 != "0"
      DetailPrint "CGS: PATH ${MODE} failed; the user PATH was left unchanged"
    ${EndIf}
  ${Else}
    DetailPrint "CGS: PATH ${MODE} skipped: $cgsPathHelper is missing"
  ${EndIf}
!macroend

!macro customInstall
  ; The helper lives outside the toolchain root so uninstall can still run it while removing that root.
  CreateDirectory "$cgsPathHelperDir"
  SetOutPath "$cgsPathHelperDir"
  File "/oname=cgs-path.ps1" "${BUILD_RESOURCES_DIR}/win-path.ps1"
  SetOutPath "$INSTDIR"
  ${If} ${isUpdated}
    ; An update keeps whatever the user chose: only re-record the entries that are still there.
    !insertmacro CGS_RunPathHelper "refresh"
  ${ElseIf} $cgsAddToPath == "1"
    !insertmacro CGS_RunPathHelper "add"
  ${Else}
    DetailPrint "CGS: user chose not to add the tools to the user PATH"
  ${EndIf}
!macroend

!macro customUnInstall
  !insertmacro CGS_InitHelperPaths
  ${If} ${isUpdated}
    DetailPrint "CGS: update; keeping the user PATH and the toolchain"
  ${Else}
    ; Remove only the recorded PATH entries, then the toolchain root. The helper is deleted after it has run.
    !insertmacro CGS_RunPathHelper "remove"
    RMDir /r "${CGS_TOOLCHAIN_ROOT}"
    ${If} ${FileExists} "${CGS_TOOLCHAIN_ROOT}"
      DetailPrint "CGS: the toolchain directory could not be removed completely"
    ${EndIf}
    Delete "$cgsPathHelper"
    Delete "$cgsPathHelperDir\cgs-path.log"
    RMDir "$cgsPathHelperDir"
  ${EndIf}
!macroend

!endif

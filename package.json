{
  "name": "cgs-desktop",
  "productName": "CGS Desktop",
  "version": "0.3.0-next",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "desktop": "node scripts/dev-desktop.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:desktop": "vite build --base=./",
    "dist:linux": "bun run build:desktop && electron-builder --linux AppImage --x64 --publish never && node installer/linux/build.mjs",
    "dist:win": "bun run build:desktop && electron-builder --win --x64 --publish never",
    "smoke:desktop": "xvfb-run -a electron test/desktop/smoke/main.mjs --no-sandbox",
    "e2e:desktop": "bun run build:desktop && xvfb-run -a electron test/e2e/main.mjs --no-sandbox"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "linkedom": "^0.18.15",
    "react": "19",
    "react-dom": "19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@jsquash/jpeg": "^1.6.0",
    "cn-fontsource-975-maru-sc-regular": "^1.0.1",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.82.0",
    "mermaid": "^12.3.0"
  },
  "cgsVersion": "19.2.1-cgs.5.4",
  "bunInstall": {
    "version": "1.4.4",
    "sha256": {
      "bun-linux-x64": "bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c",
      "bun-linux-x64-baseline": "e0446eb55995772eb9894bebae9a6be368d985a8b9271ee124486f9946eedd76",
      "bun-linux-aarch64": "baa6bb36f51d6e58561e02bbea825038a9df454f673d6d776e8bbf86f8c7850e",
      "bun-darwin-x64": "50a3491f73abc2fe81673171a85762d3bc2cc1680ccecadd983de99adf77977e",
      "bun-darwin-x64-baseline": "d4a155adfbfd09155eb3ba05c9e3a544f39297d7a68616d3c7759f67ab5c47dc",
      "bun-darwin-aarch64": "c240d7f0ccb90c263a849fcdb09b7ee62630d921348ed6aafda86b9d577bc510"
    }
  },
  "build": {
    "appId": "com.cicori.cgs-desktop",
    "productName": "CGS Desktop",
    "executableName": "cgs-desktop",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "package.json",
      "desktop/**/*",
      "dist/**/*"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "CicoriOS",
        "repo": "cgs-desktop",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "CGS-Desktop-${version}-${arch}.${ext}",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CGS-Desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "description": "CGS Desktop: the CGS web client around the local cgs CLI",
  "author": "Cicori"
}

{
  "name": "cgs-desktop",
  "productName": "CGS Desktop",
  "version": "0.1.0",
  "description": "CGS Desktop: omp coding agent + ompweb in a desktop window, with the CGS provider",
  "desktopName": "cgs-desktop.desktop",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Cicori",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fetch": "node scripts/fetch-upstream.mjs",
    "fetch:win": "node scripts/fetch-upstream.mjs --target win-x64",
    "fetch:linux": "node scripts/fetch-upstream.mjs --target linux-x64",
    "icons": "electron scripts/build-icons.js --no-sandbox",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "node scripts/fetch-upstream.mjs --target win-x64 && electron-builder --win --x64 --publish never",
    "dist:linux": "node scripts/fetch-upstream.mjs --target linux-x64 && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cicori.cgs-desktop",
    "productName": "CGS Desktop",
    "executableName": "CGS Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*",
      "assets/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "extraResources": [
      {
        "from": "plugin/omp-cgs",
        "to": "plugin/omp-cgs",
        "filter": [
          "**/*",
          "!node_modules/.cache/**"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        { "from": "vendor/win-x64/omp", "to": "omp" },
        { "from": "vendor/win-x64/ompweb", "to": "ompweb" },
        { "from": "vendor/win-x64/chromium", "to": "chromium" }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "cgs-desktop",
      "artifactName": "CGS-Desktop-${version}-${arch}.${ext}",
      "syncDesktopName": true,
      "extraResources": [
        { "from": "vendor/linux-x64/omp", "to": "omp" },
        { "from": "vendor/linux-x64/ompweb", "to": "ompweb" },
        { "from": "vendor/linux-x64/chromium", "to": "chromium" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
